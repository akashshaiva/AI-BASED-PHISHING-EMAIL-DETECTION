# Flask runtime
FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret

# Frontend/API access
ALLOWED_ORIGINS=http://localhost:5000,https://your-domain.example.com

# Upload settings
MAX_UPLOAD_SIZE=5242880
UPLOAD_FOLDER=./backend/uploads

# Database
DATABASE_PATH=./backend/data/phishguard.db
# If using PostgreSQL in production, set DATABASE_URL instead and override the DB code accordingly.
# DATABASE_URL=postgresql://user:password@host:5432/phishguard

# Security
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https
